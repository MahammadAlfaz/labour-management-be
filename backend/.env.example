ENVIRONMENT=development
DEBUG=true

MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=labour_management

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated bootstrap admin emails (Google account emails).
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# This bucket must exist and be marked PUBLIC in Supabase Storage --
# labourer/site photos are served via public URLs (they aren't sensitive,
# so this avoids the extra complexity/staleness of signed URLs). Create it
# once via the Supabase dashboard or:
#   POST {SUPABASE_URL}/storage/v1/bucket  body: {"name": "...", "public": true}
#   (Authorization: Bearer <SUPABASE_SECRET_KEY>, apikey: <SUPABASE_SECRET_KEY>)
SUPABASE_BUCKET=labour-management

# Used for the wall-calculator feature's handwritten measurement extraction.
# Leave blank to disable AI extraction -- manual measurement entry still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
